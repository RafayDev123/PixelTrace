# Copy to .env and adjust. Never commit real credentials.
# PostgreSQL connection (Docker: `docker compose up -d db` uses these defaults)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Upload limits (defaults shown)
PIXELTRACE_MAX_FILES=10
PIXELTRACE_MAX_FILE_MB=20
PIXELTRACE_MAX_MEGAPIXELS=40
PIXELTRACE_BULK_CONCURRENCY=3
PIXELTRACE_RATE_LIMIT_PER_MIN=120

# Optional cloud mode is DISABLED by default. See docs/ARCHITECTURE.md.
# This build contains no storage provider; the flag only reports status in Settings.
PIXELTRACE_CLOUD_ENABLED=false
# Placeholders for a future S3-compatible private bucket (leave empty, never commit real values):
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
